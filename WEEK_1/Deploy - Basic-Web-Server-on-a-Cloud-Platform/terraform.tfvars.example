# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored so you don't accidentally commit personal/account-specific info.

aws_region          = "us-east-1"
project_name        = "hug-terraform-challenge"
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
availability_zone   = "us-east-1a"
instance_type       = "t2.micro"

# Name of an EC2 key pair you already created in the AWS console (for SSH access).
# Leave as "" if you don't need SSH access.
key_name            = ""

# Restrict this to your own public IP in CIDR form, e.g. "203.0.113.10/32"
ssh_allowed_cidr    = "0.0.0.0/0"

# Content shown on the web page
full_name           = "Firstname Lastname"
event_name          = "HUG Lagos/Ibadan Terraform Challenge"
