# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored so you never commit secrets or your IP.

project_name = "two-tier-app"
aws_region   = "us-east-1"

availability_zones = ["us-east-1a", "us-east-1b"]

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidr   = "10.0.1.0/24"
private_subnet_cidrs = ["10.0.2.0/24", "10.0.3.0/24"]

# Find your public IP with: curl ifconfig.me
my_ip_cidr = "203.0.113.5/32"

instance_type = "t3.micro"
key_name      = "my-ec2-keypair"

db_engine             = "mysql"
db_engine_version     = "8.0"
db_instance_class     = "db.t3.micro"
db_allocated_storage  = 20
db_port               = 3306
db_name               = "appdb"
db_username           = "admin"
db_password           = "ChangeMe_UseASecretManagerInReality!"

tags = {
  Project     = "two-tier-app"
  Environment = "dev"
  ManagedBy   = "terraform"
  Owner       = "your-name"
}
